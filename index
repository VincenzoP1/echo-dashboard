var radarLayer = null;


function loadRainRadar() {

  fetch(
    "https://api.rainviewer.com/public/weather-maps.json"
  )

  .then(function(r) {
    return r.json();
  })

  .then(function(data) {

    var frames =
      data.radar &&
      data.radar.past ?
      data.radar.past :
      [];

    if (!frames.length) {
      return;
    }

    var frame =
      frames[
        frames.length - 1
      ];

    if (radarLayer) {
      weatherMap.removeLayer(
        radarLayer
      );
    }

    radarLayer =
      L.tileLayer(
        data.host +
        frame.path +
        "/256/{z}/{x}/{y}/2/1_1.png",
        {
          tileSize: 256,
          opacity: .72,
          maxNativeZoom: 7,
          maxZoom: 12
        }
      );

    radarLayer.addTo(
      weatherMap
    );


    var d =
      new Date(
        frame.time * 1000
      );

    document
      .getElementById(
        "radarTime"
      )
      .innerHTML =
      "RADAR " +
      ("0" + d.getHours()).slice(-2) +
      ":" +
      ("0" + d.getMinutes()).slice(-2);

  });

}


