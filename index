<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport"
      content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">

<title>Siderno Station</title>

<link rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">

<style>
* {
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}

html, body {
  margin: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #020705;
  color: #72ff91;
  font-family: "Courier New", monospace;
}

:root {
  --green: #72ff91;
  --green2: #36a957;
  --dim: #205d35;
  --black: #020705;
  --panel: #06100b;
  --line: rgba(114,255,145,.28);
}

#app {
  position: fixed;
  inset: 0;
  background: var(--black);
}

/* ---------- HEADER ---------- */

#topbar {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 46px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 16px;

  border-bottom: 1px solid var(--line);
  background: rgba(2,7,5,.97);

  z-index: 50;
}

.brand {
  font-weight: bold;
  letter-spacing: 2px;
  font-size: 15px;
}

#clock {
  font-size: 15px;
  letter-spacing: 1px;
}

/* ---------- SCREENS ---------- */

.screen {
  display: none;

  position: absolute;
  left: 0;
  right: 0;
  top: 46px;
  bottom: 55px;

  overflow: hidden;
}

.screen.active {
  display: block;
}

/* ---------- NAV ---------- */

#nav {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;

  height: 55px;

  display: flex;

  background: #030a06;
  border-top: 1px solid var(--line);

  z-index: 100;
}

.navbtn {
  flex: 1;

  border: 0;
  border-right: 1px solid var(--line);

  background: transparent;
  color: #398c50;

  font-family: inherit;
  font-size: 14px;
  font-weight: bold;
  letter-spacing: 1px;
}

.navbtn:last-child {
  border-right: 0;
}

.navbtn.active {
  color: var(--green);
  background: rgba(114,255,145,.07);
}

/* =====================================
   RADAR
===================================== */

#radarScreen {
  background:
    radial-gradient(circle at center,
      rgba(22,72,39,.14),
      #020705 68%);
}

#radarCanvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

#radarStatus {
  position: absolute;
  top: 10px;
  left: 12px;

  font-size: 11px;
  line-height: 1.45;

  color: #4aaa64;

  pointer-events: none;
}

#aircraftCount {
  color: var(--green);
}

#planeInfo {
  position: absolute;
  top: 8px;
  right: 8px;

  width: 175px;

  display: none;

  padding: 9px 10px;

  background: rgba(2,10,6,.94);
  border: 1px solid rgba(114,255,145,.45);

  font-size: 11px;
  line-height: 1.45;

  z-index: 10;
}

#planeInfo .callsign {
  font-size: 16px;
  color: #b6ffc7;
  margin-bottom: 4px;
}

#planeInfo .close {
  position: absolute;
  right: 7px;
  top: 5px;
  font-size: 16px;
}

/* =====================================
   WEATHER
===================================== */

#weatherScreen {
  background: #030907;
}

#weatherMap {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 58%;
  background: #07100d;
}

.weather-panel {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;

  width: 42%;

  padding: 12px;

  background: #06100b;
  border-left: 1px solid var(--line);

  overflow: hidden;
}

.current-weather {
  padding-bottom: 10px;
  border-bottom: 1px solid var(--line);
}

.weather-place {
  font-size: 11px;
  color: #4aaa64;
  letter-spacing: 2px;
}

.weather-main {
  display: flex;
  align-items: center;
  gap: 9px;
}

#weatherIcon {
  font-size: 28px;
}

#temperature {
  font-size: 34px;
  color: #b4ffc4;
}

#weatherDescription {
  font-size: 12px;
  margin-top: 2px;
}

.weather-details {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4px;

  margin-top: 8px;

  font-size: 10px;
  color: #69c47d;
}

.forecast-title {
  margin-top: 10px;
  margin-bottom: 5px;

  font-size: 10px;
  letter-spacing: 2px;
  color: #4aaa64;
}

#forecast {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.forecast-row {
  display: grid;
  grid-template-columns: 38px 26px 45px 1fr;

  align-items: center;

  min-height: 29px;

  padding: 3px 4px;

  background: rgba(114,255,145,.035);
  border-left: 2px solid #205d35;

  font-size: 10px;
}

.fc-time {
  color: #4aaa64;
}

.fc-temp {
  color: #b4ffc4;
}

.fc-rain {
  text-align: right;
  color: #67b97a;
}

#radarTime {
  position: absolute;
  left: 8px;
  bottom: 7px;

  z-index: 999;

  background: rgba(0,0,0,.65);
  padding: 4px 6px;

  font-size: 9px;
  color: #a0eeb0;
}

/* dark Leaflet */

.leaflet-control-zoom,
.leaflet-control-attribution {
  display: none !important;
}

.leaflet-container {
  background: #030807;
}

/* =====================================
   SKY
===================================== */

#skyScreen {
  background:
    radial-gradient(circle at center,
      #07110c 0%,
      #020504 72%);
}

#skyCanvas {
  position: absolute;
  inset: 0;

  width: 100%;
  height: 100%;
}

#skyInfo {
  position: absolute;
  top: 10px;
  left: 12px;

  font-size: 11px;
  line-height: 1.5;

  color: #4aaa64;
}

#skyInfo strong {
  color: var(--green);
}

#skyLegend {
  position: absolute;
  right: 10px;
  bottom: 8px;

  font-size: 9px;
  color: #3c8850;
}
</style>
</head>

<body>

<div id="app">

  <div id="topbar">
    <div class="brand">SIDERNO STATION</div>
    <div id="clock">--:--</div>
  </div>

  <!-- RADAR -->

  <div id="radarScreen" class="screen active">

    <canvas id="radarCanvas"></canvas>

    <div id="radarStatus">
      ADS-B LIVE<br>
      RANGE 200 KM<br>
      AIRCRAFT <span id="aircraftCount">--</span>
    </div>

    <div id="planeInfo"></div>

  </div>


  <!-- WEATHER -->

  <div id="weatherScreen" class="screen">

    <div id="weatherMap"></div>

    <div id="radarTime">
      RADAR --
    </div>

    <div class="weather-panel">

      <div class="current-weather">

        <div class="weather-place">
          SIDERNO • METEO
        </div>

        <div class="weather-main">
          <div id="weatherIcon">--</div>
          <div id="temperature">--°</div>
        </div>

        <div id="weatherDescription">
          Caricamento...
        </div>

        <div class="weather-details">

          <div>
            PERCEPITA<br>
            <span id="feels">--°</span>
          </div>

          <div>
            UMIDITÀ<br>
            <span id="humidity">--%</span>
          </div>

          <div>
            VENTO<br>
            <span id="wind">-- km/h</span>
          </div>

          <div>
            PIOGGIA<br>
            <span id="rainNow">-- mm</span>
          </div>

        </div>

      </div>

      <div class="forecast-title">
        PROSSIME ORE
      </div>

      <div id="forecast"></div>

    </div>

  </div>


  <!-- SKY -->

  <div id="skyScreen" class="screen">

    <canvas id="skyCanvas"></canvas>

    <div id="skyInfo">
      <strong>CIELO • SIDERNO</strong><br>
      LIVE SKY MAP<br>
      <span id="skyDate"></span>
    </div>

    <div id="skyLegend">
      CENTRO = ZENIT • BORDO = ORIZZONTE
    </div>

  </div>


  <!-- NAV -->

  <div id="nav">

    <button class="navbtn active"
            data-screen="radarScreen">
      ✈ RADAR
    </button>

    <button class="navbtn"
            data-screen="weatherScreen">
      ☁ METEO
    </button>

    <button class="navbtn"
            data-screen="skyScreen">
      ✦ CIELO
    </button>

  </div>

</div>


<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>

/* =====================================
   CONFIG
===================================== */

var LAT = 38.27;
var LON = 16.30;

var MAX_RANGE = 200;

var ADSB_URL =
  "https://echo-show.akagigino.workers.dev/";


/* =====================================
   CLOCK
===================================== */

function updateClock() {

  var d = new Date();

  document.getElementById("clock").innerHTML =
    ("0" + d.getHours()).slice(-2) +
    ":" +
    ("0" + d.getMinutes()).slice(-2);

}

updateClock();
setInterval(updateClock, 10000);


/* =====================================
   NAVIGATION
===================================== */

var buttons =
  document.getElementsByClassName("navbtn");

for (var b = 0; b < buttons.length; b++) {

  buttons[b].onclick = function() {

    var screens =
      document.getElementsByClassName("screen");

    for (var i = 0; i < screens.length; i++) {
      screens[i].className = "screen";
    }

    for (var j = 0; j < buttons.length; j++) {
      buttons[j].className = "navbtn";
    }

    document
      .getElementById(
        this.getAttribute("data-screen")
      )
      .className =
      "screen active";

    this.className =
      "navbtn active";


    if (
      this.getAttribute("data-screen") ===
      "weatherScreen"
    ) {

      setTimeout(function() {
        weatherMap.invalidateSize();
      }, 150);

    }

    if (
      this.getAttribute("data-screen") ===
      "radarScreen"
    ) {

      resizeRadar();

    }

    if (
      this.getAttribute("data-screen") ===
      "skyScreen"
    ) {

      drawSky();

    }

  };

}


/* =====================================
   FULLSCREEN
===================================== */

document.body.addEventListener(
  "dblclick",
  function() {

    var el =
      document.documentElement;

    if (el.requestFullscreen) {
      el.requestFullscreen();
    } else if (el.webkitRequestFullscreen) {
      el.webkitRequestFullscreen();
    }

  }
);


/* =====================================
   GEOGRAPHY
===================================== */

function haversine(
  lat1,
  lon1,
  lat2,
  lon2
) {

  var R = 6371;

  var dLat =
    (lat2 - lat1) *
    Math.PI / 180;

  var dLon =
    (lon2 - lon1) *
    Math.PI / 180;

  var a =
    Math.sin(dLat / 2) *
    Math.sin(dLat / 2) +

    Math.cos(lat1 * Math.PI / 180) *
    Math.cos(lat2 * Math.PI / 180) *

    Math.sin(dLon / 2) *
    Math.sin(dLon / 2);

  return R * 2 *
    Math.atan2(
      Math.sqrt(a),
      Math.sqrt(1 - a)
    );
}


function bearing(
  lat1,
  lon1,
  lat2,
  lon2
) {

  var p1 =
    lat1 * Math.PI / 180;

  var p2 =
    lat2 * Math.PI / 180;

  var dl =
    (lon2 - lon1) *
    Math.PI / 180;

  var y =
    Math.sin(dl) *
    Math.cos(p2);

  var x =
    Math.cos(p1) *
    Math.sin(p2) -

    Math.sin(p1) *
    Math.cos(p2) *
    Math.cos(dl);

  var brng =
    Math.atan2(y, x) *
    180 / Math.PI;

  return (brng + 360) % 360;
}


/* =====================================
   ADS-B RADAR
===================================== */

var radar =
  document.getElementById("radarCanvas");

var rctx =
  radar.getContext("2d");

var aircraft = [];

var planeHitAreas = [];

var trails = {};


function resizeRadar() {

  radar.width =
    radar.clientWidth *
    window.devicePixelRatio;

  radar.height =
    radar.clientHeight *
    window.devicePixelRatio;

  rctx.setTransform(
    window.devicePixelRatio,
    0,
    0,
    window.devicePixelRatio,
    0,
    0
  );

  drawRadar();

}


function drawPlane(
  ctx,
  x,
  y,
  heading
) {

  ctx.save();

  ctx.translate(x, y);

  ctx.rotate(
    heading *
    Math.PI / 180
  );

  ctx.beginPath();

  ctx.moveTo(0, -8);
  ctx.lineTo(3, -2);
  ctx.lineTo(10, 1);
  ctx.lineTo(10, 3);
  ctx.lineTo(3, 2);
  ctx.lineTo(2, 7);
  ctx.lineTo(5, 9);
  ctx.lineTo(5, 10);
  ctx.lineTo(0, 8);
  ctx.lineTo(-5, 10);
  ctx.lineTo(-5, 9);
  ctx.lineTo(-2, 7);
  ctx.lineTo(-3, 2);
  ctx.lineTo(-10, 3);
  ctx.lineTo(-10, 1);
  ctx.lineTo(-3, -2);

  ctx.closePath();

  ctx.strokeStyle =
    "#72ff91";

  ctx.lineWidth = 1;

  ctx.stroke();

  ctx.restore();

}


function drawRadar() {

  var w =
    radar.clientWidth;

  var h =
    radar.clientHeight;

  rctx.clearRect(
    0,
    0,
    w,
    h
  );

  var cx = w / 2;
  var cy = h / 2;

  var radius =
    Math.min(
      w * 0.39,
      h * 0.43
    );

  rctx.strokeStyle =
    "rgba(114,255,145,.23)";

  rctx.lineWidth = 1;


  /* rings */

  for (var ring = 1; ring <= 4; ring++) {

    rctx.beginPath();

    rctx.arc(
      cx,
      cy,
      radius * ring / 4,
      0,
      Math.PI * 2
    );

    rctx.stroke();

  }


  /* cross */

  rctx.beginPath();

  rctx.moveTo(
    cx - radius,
    cy
  );

  rctx.lineTo(
    cx + radius,
    cy
  );

  rctx.moveTo(
    cx,
    cy - radius
  );

  rctx.lineTo(
    cx,
    cy + radius
  );

  rctx.stroke();


  /* diagonals */

  rctx.strokeStyle =
    "rgba(114,255,145,.08)";

  rctx.beginPath();

  rctx.moveTo(
    cx - radius * .7,
    cy - radius * .7
  );

  rctx.lineTo(
    cx + radius * .7,
    cy + radius * .7
  );

  rctx.moveTo(
    cx + radius * .7,
    cy - radius * .7
  );

  rctx.lineTo(
    cx - radius * .7,
    cy + radius * .7
  );

  rctx.stroke();


  /* labels */

  rctx.fillStyle =
    "#4aaa64";

  rctx.font =
    "10px Courier New";

  rctx.textAlign =
    "center";

  rctx.fillText(
    "N",
    cx,
    cy - radius - 7
  );

  rctx.fillText(
    "S",
    cx,
    cy + radius + 14
  );

  rctx.fillText(
    "W",
    cx - radius - 10,
    cy + 3
  );

  rctx.fillText(
    "E",
    cx + radius + 10,
    cy + 3
  );


  /* range numbers */

  rctx.textAlign =
    "left";

  rctx.fillText(
    "50",
    cx + radius * .25 + 3,
    cy - 3
  );

  rctx.fillText(
    "100",
    cx + radius * .50 + 3,
    cy - 3
  );

  rctx.fillText(
    "150",
    cx + radius * .75 + 3,
    cy - 3
  );

  rctx.fillText(
    "200 KM",
    cx + radius + 3,
    cy - 3
  );


  /* center */

  rctx.fillStyle =
    "#72ff91";

  rctx.fillRect(
    cx - 2,
    cy - 2,
    4,
    4
  );


  planeHitAreas = [];


  for (
    var i = 0;
    i < aircraft.length;
    i++
  ) {

    var p = aircraft[i];

    if (
      typeof p.lat !== "number" ||
      typeof p.lon !== "number"
    ) {
      continue;
    }

    var dist =
      haversine(
        LAT,
        LON,
        p.lat,
        p.lon
      );

    if (
      dist > MAX_RANGE
    ) {
      continue;
    }

    var brg =
      bearing(
        LAT,
        LON,
        p.lat,
        p.lon
      );

    var rr =
      radius *
      dist /
      MAX_RANGE;

    var angle =
      (brg - 90) *
      Math.PI / 180;

    var x =
      cx +
      Math.cos(angle) *
      rr;

    var y =
      cy +
      Math.sin(angle) *
      rr;


    /* trails */

    var id =
      p.hex || ("p" + i);

    if (!trails[id]) {
      trails[id] = [];
    }

    var tr =
      trails[id];

    if (tr.length > 1) {

      rctx.strokeStyle =
        "rgba(68,180,92,.30)";

      rctx.beginPath();

      for (
        var t = 0;
        t < tr.length;
        t++
      ) {

        if (t === 0) {
          rctx.moveTo(
            tr[t].x,
            tr[t].y
          );
        } else {
          rctx.lineTo(
            tr[t].x,
            tr[t].y
          );
        }

      }

      rctx.stroke();

    }


    drawPlane(
      rctx,
      x,
      y,
      p.track || 0
    );


    /* callsign */

    var call =
      p.flight ?
      p.flight.replace(/\s/g, "") :
      p.hex.toUpperCase();

    rctx.font =
      "10px Courier New";

    rctx.textAlign =
      "left";

    rctx.fillStyle =
      "#9cffb1";

    rctx.fillText(
      call,
      x + 10,
      y - 3
    );


    /* flight level */

    if (
      typeof p.alt_baro === "number"
    ) {

      rctx.fillStyle =
        "#4aaa64";

      rctx.fillText(
        "FL" +
        Math.round(
          p.alt_baro / 100
        ),
        x + 10,
        y + 8
      );

    }


    planeHitAreas.push({
      x: x,
      y: y,
      plane: p,
      distance: dist
    });

  }

}


function updateTrails() {

  for (
    var i = 0;
    i < aircraft.length;
    i++
  ) {

    var p =
      aircraft[i];

    if (
      typeof p.lat !== "number" ||
      typeof p.lon !== "number"
    ) {
      continue;
    }

    var dist =
      haversine(
        LAT,
        LON,
        p.lat,
        p.lon
      );

    if (
      dist > MAX_RANGE
    ) {
      continue;
    }

    var w =
      radar.clientWidth;

    var h =
      radar.clientHeight;

    var cx = w / 2;
    var cy = h / 2;

    var radius =
      Math.min(
        w * .39,
        h * .43
      );

    var brg =
      bearing(
        LAT,
        LON,
        p.lat,
        p.lon
      );

    var rr =
      radius *
      dist /
      MAX_RANGE;

    var angle =
      (brg - 90) *
      Math.PI / 180;

    var x =
      cx +
      Math.cos(angle) *
      rr;

    var y =
      cy +
      Math.sin(angle) *
      rr;

    var id =
      p.hex || ("p" + i);

    if (!trails[id]) {
      trails[id] = [];
    }

    trails[id].push({
      x: x,
      y: y
    });

    if (
      trails[id].length > 12
    ) {
      trails[id].shift();
    }

  }

}


function loadAircraft() {

  fetch(
    ADSB_URL + "?t=" +
    new Date().getTime()
  )

  .then(function(r) {

    if (!r.ok) {
      throw new Error(
        "HTTP " + r.status
      );
    }

    return r.json();

  })

  .then(function(data) {

    aircraft =
      data.ac || [];

    document
      .getElementById(
        "aircraftCount"
      )
      .innerHTML =
      aircraft.length;

    updateTrails();

    drawRadar();

  })

  .catch(function() {

    document
      .getElementById(
        "aircraftCount"
      )
      .innerHTML =
      "OFF";

  });

}


radar.addEventListener(
  "click",
  function(e) {

    var rect =
      radar.getBoundingClientRect();

    var x =
      e.clientX -
      rect.left;

    var y =
      e.clientY -
      rect.top;

    var closest = null;

    var best = 22;

    for (
      var i = 0;
      i < planeHitAreas.length;
      i++
    ) {

      var h =
        planeHitAreas[i];

      var d =
        Math.sqrt(
          Math.pow(
            x - h.x,
            2
          ) +
          Math.pow(
            y - h.y,
            2
          )
        );

      if (d < best) {
        best = d;
        closest = h;
      }

    }

    if (closest) {
      showPlaneInfo(
        closest.plane,
        closest.distance
      );
    }

  }
);


function showPlaneInfo(
  p,
  distance
) {

  var call =
    p.flight ?
    p.flight.replace(/\s/g, "") :
    p.hex;

  var vs =
    p.baro_rate || 0;

  var vsText =
    Math.abs(vs) < 100 ?
    "LEVEL" :
    (
      vs > 0 ?
      "+" + vs :
      vs
    ) + " ft/min";

  var box =
    document.getElementById(
      "planeInfo"
    );

  box.innerHTML =

    '<span class="close">×</span>' +

    '<div class="callsign">' +
    call +
    '</div>' +

    (p.r || "----") +
    " • " +
    (p.t || "----") +

    "<br><br>" +

    "ALT&nbsp;&nbsp; " +
    (
      typeof p.alt_baro === "number" ?
      p.alt_baro.toLocaleString() +
      " ft" :
      "--"
    ) +

    "<br>" +

    "GS&nbsp;&nbsp;&nbsp; " +
    (
      typeof p.gs === "number" ?
      Math.round(p.gs) +
      " kt" :
      "--"
    ) +

    "<br>" +

    "HDG&nbsp;&nbsp; " +
    (
      typeof p.track === "number" ?
      Math.round(p.track) +
      "°" :
      "--"
    ) +

    "<br>" +

    "V/S&nbsp;&nbsp; " +
    vsText +

