function weatherInfo(code) {

  if (code === 0)
    return ["☀", "Sereno"];

  if (
    code === 1 ||
    code === 2
  )
    return ["◐", "Poco nuvoloso"];

  if (code === 3)
    return ["☁", "Nuvoloso"];

  if (
    code === 45 ||
    code === 48
  )
    return ["≋", "Nebbia"];

  if (
    code >= 51 &&
    code <= 57
  )
    return ["☂", "Pioviggine"];

  if (
    code >= 61 &&
    code <= 67
  )
    return ["☂", "Pioggia"];

  if (
    code >= 71 &&
    code <= 77
  )
    return ["❄", "Neve"];

  if (
    code >= 80 &&
    code <= 82
  )
    return ["☂", "Rovesci"];

  if (code >= 95)
    return ["ϟ", "Temporale"];

  return ["·", "Variabile"];
}


function loadWeather() {

  var url =
    "https://api.open-meteo.com/v1/forecast" +

    "?latitude=" +
    LAT +

    "&longitude=" +
    LON +

    "&current=" +
    "temperature_2m," +
    "relative_humidity_2m," +
    "apparent_temperature," +
    "precipitation," +
    "weather_code," +
    "wind_speed_10m" +

    "&hourly=" +
    "temperature_2m," +
    "precipitation_probability," +
    "weather_code" +

    "&forecast_days=2" +

    "&timezone=Europe%2FRome";


  fetch(url)

  .then(function(r) {
    return r.json();
  })

  .then(function(data) {

    var c =
      data.current;

    var wi =
      weatherInfo(
        c.weather_code
      );

    document
      .getElementById(
        "weatherIcon"
      )
      .innerHTML =
      wi[0];

    document
      .getElementById(
        "temperature"
      )
      .innerHTML =
      Math.round(
        c.temperature_2m
      ) + "°";

    document
      .getElementById(
        "weatherDescription"
      )
      .innerHTML =
      wi[1];

    document
      .getElementById(
        "feels"
      )
      .innerHTML =
      Math.round(
        c.apparent_temperature
      ) + "°";

    document
      .getElementById(
        "humidity"
      )
      .innerHTML =
      c.relative_humidity_2m +
      "%";

    document
      .getElementById(
        "wind"
      )
      .innerHTML =
      Math.round(
        c.wind_speed_10m
      ) +
      " km/h";

    document
      .getElementById(
        "rainNow"
      )
      .innerHTML =
      c.precipitation +
      " mm";


    /* forecast */

    var hourly =
      data.hourly;

    var now =
      new Date();

    var start = 0;

    for (
      var i = 0;
      i < hourly.time.length;
      i++
    ) {

      if (
        new Date(
          hourly.time[i]
        ) >= now
      ) {
        start = i;
        break;
      }

    }

    var html = "";

    /*
      5 righe, ogni 3 ore
    */

    for (
      var n = 0;
      n < 5;
      n++
    ) {

      var idx =
        start +
        n * 3;

      if (
        idx >=
        hourly.time.length
      ) {
        break;
      }

      var time =
        new Date(
          hourly.time[idx]
        );

      var icon =
        weatherInfo(
          hourly.weather_code[idx]
        )[0];

      html +=

        '<div class="forecast-row">' +

          '<div class="fc-time">' +
            ("0" + time.getHours()).slice(-2) +
            ":00" +
          '</div>' +

          '<div>' +
            icon +
          '</div>' +

          '<div class="fc-temp">' +
            Math.round(
              hourly.temperature_2m[idx]
            ) +
            "°" +
          '</div>' +

          '<div class="fc-rain">' +
            hourly.precipitation_probability[idx] +
            "% ☂" +
          '</div>' +

        '</div>';

    }

    document
      .getElementById(
        "forecast"
      )
      .innerHTML =
      html;

  });

}


