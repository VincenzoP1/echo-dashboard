function julianDate(date) {

  return (
    date.getTime() /
    86400000
  ) + 2440587.5;

}


function localSiderealTime(date) {

  var jd =
    julianDate(date);

  var d =
    jd -
    2451545.0;

  var gst =
    18.697374558 +
    24.06570982441908 *
    d;

  var lst =
    gst +
    LON / 15;

  lst =
    ((lst % 24) + 24) %
    24;

  return lst;

}


function starAltAz(
  ra,
  dec,
  date
) {

  var lst =
    localSiderealTime(date);

  var H =
    (lst - ra) *
    15 *
    Math.PI / 180;

  var decR =
    dec *
    Math.PI / 180;

  var latR =
    LAT *
    Math.PI / 180;

  var sinAlt =
    Math.sin(decR) *
    Math.sin(latR) +

    Math.cos(decR) *
    Math.cos(latR) *
    Math.cos(H);

  var alt =
    Math.asin(sinAlt);

  var y =
    -Math.sin(H) *
    Math.cos(decR);

  var x =
    Math.sin(decR) *
    Math.cos(latR) -

    Math.cos(decR) *
    Math.sin(latR) *
    Math.cos(H);

  var az =
    Math.atan2(y, x);

  if (az < 0) {
    az += Math.PI * 2;
  }

  return {
    alt:
      alt * 180 / Math.PI,

    az:
      az * 180 / Math.PI
  };

}


function drawSky() {

  sky.width =
    sky.clientWidth *
    window.devicePixelRatio;

  sky.height =
    sky.clientHeight *
    window.devicePixelRatio;

  sctx.setTransform(
    window.devicePixelRatio,
    0,
    0,
    window.devicePixelRatio,
    0,
    0
  );

  var w =
    sky.clientWidth;

  var h =
    sky.clientHeight;

  sctx.clearRect(
    0,
    0,
    w,
    h
  );

  var cx =
    w / 2;

  var cy =
    h / 2 + 5;

  var radius =
    Math.min(
      w * .38,
      h * .43
    );


  /* horizon */

  sctx.strokeStyle =
    "rgba(114,255,145,.30)";

  sctx.lineWidth = 1;

  sctx.beginPath();

  sctx.arc(
    cx,
    cy,
    radius,
    0,
    Math.PI * 2
  );

  sctx.stroke();


  /* altitude circles */

  sctx.strokeStyle =
    "rgba(114,255,145,.10)";

  sctx.beginPath();

  sctx.arc(
    cx,
    cy,
    radius * .66,
    0,
    Math.PI * 2
  );

  sctx.stroke();

  sctx.beginPath();

  sctx.arc(
    cx,
    cy,
    radius * .33,
    0,
    Math.PI * 2
  );

  sctx.stroke();


  /* directions */

  sctx.fillStyle =
    "#4aaa64";

  sctx.font =
    "11px Courier New";

  sctx.textAlign =
    "center";

  sctx.fillText(
    "N",
    cx,
    cy - radius - 7
  );

  sctx.fillText(
    "S",
    cx,
    cy + radius + 14
  );

  sctx.fillText(
    "E",
    cx + radius + 10,
    cy + 4
  );

  sctx.fillText(
    "W",
    cx - radius - 10,
    cy + 4
  );


  var now =
    new Date();


  for (
    var i = 0;
    i < stars.length;
    i++
  ) {

    var star =
      stars[i];

    var pos =
      starAltAz(
        star[1],
        star[2],
        now
      );

    if (
      pos.alt <= 0
    ) {
      continue;
    }


    /*
      Zenith = center
      Horizon = radius
    */

    var r =
      radius *
      (
        90 -
        pos.alt
      ) /
      90;

    var a =
      (
        pos.az -
        90
      ) *
      Math.PI / 180;

    var x =
      cx +
      Math.cos(a) *
      r;

    var y =
      cy +
      Math.sin(a) *
      r;


    var size =
      Math.max(
        1,
        3.1 -
        star[3]
      );


    sctx.fillStyle =
      "#d6ffdf";

    sctx.beginPath();

    sctx.arc(
      x,
      y,
      size,
      0,
      Math.PI * 2
    );

    sctx.fill();


    /*
      Label only brighter stars
    */

    if (
      star[3] < 1.1
    ) {

      sctx.fillStyle =
        "#71c987";

      sctx.font =
        "9px Courier New";

      sctx.textAlign =
        "left";

      sctx.fillText(
        star[0],
        x + 5,
        y - 3
      );

    }

  }


  /* zenith */

  sctx.fillStyle =
    "#28673b";

  sctx.beginPath();

  sctx.arc(
    cx,
    cy,
    2,
    0,
    Math.PI * 2
  );

  sctx.fill();


  var dateText =
    ("0" + now.getDate()).slice(-2) +
    "/" +
    ("0" + (now.getMonth() + 1)).slice(-2) +
    " • " +
    ("0" + now.getHours()).slice(-2) +
    ":" +
    ("0" + now.getMinutes()).slice(-2);

  document
    .getElementById(
      "skyDate"
    )
    .innerHTML =
    dateText;

}


